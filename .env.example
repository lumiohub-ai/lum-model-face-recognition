# Compose project namespace. Set this if another stack runs on the same host
# (a teammate's, or so.stack itself) — it isolates container, network and
# volume names so `docker compose down` in one can't tear down the other.
COMPOSE_PROJECT_NAME=so-face

# Client Configuration (Tenant Identifier)
SO_CLIENT_SLUG=your_organization_slug

# PostgreSQL Database
# Same machine as so.stack: host.docker.internal
# Different machine (Tailscale): 100.x.x.x
SO_POSTGRES_HOST=host.docker.internal
SO_POSTGRES_PORT=5432
SO_POSTGRES_USER=postgres
SO_POSTGRES_PASSWORD=change_me
SO_POSTGRES_DB=smart_office

# Redis
# Same machine as so.stack: host.docker.internal
# Different machine (Tailscale): 100.x.x.x
SO_REDIS_HOST=host.docker.internal
SO_REDIS_PORT=6379
SO_REDIS_DB=0
SO_REDIS_URL=redis://host.docker.internal:6379

# Celery
SO_CELERY_BROKER_URL=redis://host.docker.internal:6379/0
SO_CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/1
SO_CELERY_CONCURRENCY=2

# --- Pipeline topology (LSO-67) ---------------------------------------------
# The pipeline runs as four specialised worker pools. Every value below has a
# working default in compose.yml; set them here only to override.

# Camera-worker routing is automatic (LSO-186): cameras hash to N fixed slots
# (cam-slot-<n>) and each camera-worker replica leases one slot at boot — no
# per-camera queue config. N is hardcoded (settings.camera_slot_count) and must
# equal the camera-worker `replicas` in compose. Nothing to set here.

# decode-worker replicas are identical and interchangeable — each claims up to
# CAPACITY cameras via a short-lived Redis lease. Size N+1, not exact-fit: for
# 12 cameras at capacity 6, run 3 replicas (18 slots), not 2, so losing one
# replica still leaves room on the survivors. Budget ~1 CPU core per 1440p
# camera and measure on the target host before raising CAPACITY — raise
# decode-worker's cpus limit in compose.yml together with it.
SO_DECODE_WORKER_REPLICAS=1
SO_DECODE_WORKER_CAPACITY=6
# Must exceed the worst case time one reconcile pass takes to claim and start
# every camera up to CAPACITY (each RTSP connect is ~1.5-2s, not instant).
SO_DECODE_LEASE_TTL_S=60

# Published image tag used by every service. compose.override.dev.yml builds
# person-tracking from local source instead; the rest reuse that image.
SO_IMAGE_TAG=0.1.0

# Edge MediaMTX (LSO-27): when set, the AI reads every camera via the edge as
# rtsp://<base>/<slug(camera_name)> (single pull, no creds in the AI, immune to
# stream_url edits). Leave empty to use the DB stream_url directly.
SO_EDGE_RTSP_BASE=rtsp://host.docker.internal:8554

# Mirrors the edge sidecar's EDGE_BRANCH_CODE — restricts this instance to one
# site's cameras. Empty means every camera, correct only for a single-site org.
SO_EDGE_BRANCH_CODE=

# Google Cloud Storage
SO_GCS_CREDENTIALS_PATH=/app/credentials/gcs-service-account.json
SO_GCS_BUCKET=your-gcs-bucket

# Action Recognition (Ollama + LLM)
SO_OLLAMA_PORT=11434
SO_OLLAMA_API_URL=http://ollama:11434
SO_OLLAMA_MODEL=gemma3:4b

# Celery Flower (monitoring UI for celery, NO NEED IN PRODUCTION)
SO_FLOWER_PORT=5555

# Metrics Monitoring Dashboard (set to false to disable completely)
SO_METRICS_ENABLED=false
SO_METRICS_PORT=8765

# Application Settings
SO_LOG_LEVEL=INFO
