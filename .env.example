## --- Environment Variables --- ##

# ============================================================================
# pgvector Database Configuration (NEW)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=face_recognition
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=face_embeddings

# ============================================================================
# Google Cloud Storage Configuration
# ============================================================================
# Path to GCS service account JSON file (place in ./keys/ directory)
GCS_CREDENTIALS_PATH=/app/keys/gcs-service-account.json
GCS_BUCKET=hbai-general-data

# Legacy variables (kept for compatibility)
BUCKET_NAME="hbai-general-data"
GOOGLE_APPLICATION_CREDENTIALS="credentials/humblebee-project-model-uploader.json"

# ============================================================================
# Backend API Configuration
# ============================================================================
SO_BACKEND_API_URL=http://localhost:7091
API_HOST="http://localhost:7091/"

# ============================================================================
# Face Recognition Service Configuration
# ============================================================================
FR_PORT=5000
FR_SLUG="face-recognition"

# Feature Flags
USE_PGVECTOR=true

# Recognition Parameters
MATCH_THRESHOLD=0.3
EMBEDDING_DIMENSION=512
FACE_DETECTION_PADDING=20.0  # Padding % added around images for better face detection (0-100)

# ============================================================================
# Camera/Stream Configuration
# ============================================================================
HB_IN="rtsp://sample:password@192.168.xxx.xxx:xxx"
HB_DEVELOPER_ZONE="rtsp://sample:password@192.168.xxx.xxx:xxx"
HB_OUT="rtsp://sample:password@192.168.xxx.xxx:xxx"

# WebRTC Streaming (Dual Camera)
RTSP1="rtsp://sample:password@192.168.xxx.xxx:xxx"
RTSP2="rtsp://sample:password@192.168.xxx.xxx:xxx"

# ============================================================================
# Admin Credentials (for testing)
# ============================================================================
HB_CLIENTSLUG='organization_slug'
SA_PASSWORD='SUPER_ADMIN_PASSWORD'
SA_EMAIL='SUPER_ADMIN_EMAIL'