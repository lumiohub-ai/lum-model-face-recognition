# Client Configuration (Tenant Identifier)
SO_CLIENT_SLUG=your_organization_slug

# PostgreSQL Database
SO_POSTGRES_HOST=x.x.x.x
SO_POSTGRES_PORT=5432
SO_POSTGRES_USER=postgres
SO_POSTGRES_PASSWORD=change_me
SO_POSTGRES_DB=smart_office

# Redis (Message-Driven Architecture)
SO_REDIS_HOST=x.x.x.x
SO_REDIS_PORT=6379

# Celery (Task Queue)
SO_CELERY_BROKER_URL=redis://x.x.x.x:6379/0
SO_CELERY_RESULT_BACKEND=redis://x.x.x.x:6379/1

# Google Cloud Storage (Proof Images)
SO_GCS_CREDENTIALS_PATH=/app/credentials/gcs-service-account.json
SO_GCS_BUCKET=your-gcs-bucket

# Action Recognition (Ollama + LLM)
SO_OLLAMA_API_URL=http://localhost:11434
SO_OLLAMA_MODEL=gemma3:4b

# Application Settings
SO_LOG_LEVEL=INFO
