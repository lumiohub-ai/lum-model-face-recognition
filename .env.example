## --- Environment Variables --- ##

# ============================================================================
# pgvector Database Configuration (NEW)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=face_recognition
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=face_embeddings

# ============================================================================
# Google Cloud Storage Configuration
# ============================================================================
# Path to GCS service account JSON file (place in ./credentials/ directory)
GCS_CREDENTIALS_PATH=/app/credentials/gcs-service-account.json
GCS_BUCKET=hbai-general-data

# Legacy variables (kept for compatibility)
BUCKET_NAME="hbai-general-data"
GOOGLE_APPLICATION_CREDENTIALS="credentials/gcs-service-account.json"

# ============================================================================
# Backend API Configuration
# ============================================================================
SO_BACKEND_API_URL=http://localhost:7091
API_HOST="http://localhost:7091/"

# ============================================================================
# Face Recognition Service Configuration
# ============================================================================
FR_PORT=5000
FR_SLUG="face-recognition"

# ============================================================================
# Camera/Stream Configuration (only needed if use_api_for_cameras=false)
# ============================================================================
# HB_IN="rtsp://sample:password@192.168.xxx.xxx:xxx"
# HB_OUT="rtsp://sample:password@192.168.xxx.xxx:xxx"

# WebRTC Streaming (Dual Camera)
# RTSP1="rtsp://sample:password@192.168.xxx.xxx:xxx"
# RTSP2="rtsp://sample:password@192.168.xxx.xxx:xxx"

# ============================================================================
# Admin Credentials (for testing)
# ============================================================================
HB_CLIENTSLUG='organization_slug'
SA_PASSWORD='SUPER_ADMIN_PASSWORD'
SA_EMAIL='SUPER_ADMIN_EMAIL'

# ============================================================================
# Redis Configuration (MDA - Message Driven Architecture)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# Celery Configuration (True MDA - Async Task Processing)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================================
# Action Recognition (Ollama)
# ============================================================================
# Ollama API URL (usually http://localhost:11435)
OLLAMA_API_URL=http://localhost:11435
# Ollama model to use (default: gemma3:4b)
OLLAMA_MODEL=gemma3:4b