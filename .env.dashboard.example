# Dashboard Configuration
# Copy this file to .env and configure for your deployment

# ============================================
# Dashboard Server Configuration
# ============================================
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_WORKERS=1

# ============================================
# CORS Configuration (Security)
# ============================================
# For production, specify exact domains instead of "*"
# Example: CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=*

# ============================================
# Streaming Configuration
# ============================================
# JPEG compression quality (50-100, higher = better quality but more bandwidth)
JPEG_QUALITY=85

# Target streaming FPS (10-60, lower = less bandwidth)
TARGET_FPS=30

# Cleanup interval for stale frames (seconds)
CLEANUP_INTERVAL=5.0

# Max consecutive failures before closing stream
MAX_STREAM_FAILURES=50

# ============================================
# Production Deployment Examples
# ============================================

# --- Example 1: Internal Network Only ---
# DASHBOARD_HOST=192.168.1.100
# CORS_ORIGINS=http://192.168.1.100:5000
# JPEG_QUALITY=90
# TARGET_FPS=30

# --- Example 2: Public Internet (Behind Reverse Proxy) ---
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=5000
# CORS_ORIGINS=https://dashboard.yourdomain.com
# JPEG_QUALITY=80
# TARGET_FPS=25

# --- Example 3: High Quality, Low Latency (LAN) ---
# JPEG_QUALITY=95
# TARGET_FPS=60
# CLEANUP_INTERVAL=2.0

# --- Example 4: Low Bandwidth, Mobile-Friendly ---
# JPEG_QUALITY=70
# TARGET_FPS=15
# CLEANUP_INTERVAL=10.0
