# Person Tracking & Phone Usage Detection - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# Client Configuration
# ============================================================================
HB_CLIENTSLUG=my_organization

# ============================================================================
# PostgreSQL (shared with face recognition service)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=face_recognition
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=face_embeddings
USE_PGVECTOR=true

# ============================================================================
# Redis (for pub/sub)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# Camera Sources (RTSP URLs or video file paths)
# ============================================================================
HB_IN=rtsp://admin:password@192.168.1.100:554/stream1
HB_OUT=rtsp://admin:password@192.168.1.101:554/stream1
HB_IN_MANAGEMENT=rtsp://admin:password@192.168.1.102:554/stream1

# Or use video files for testing:
# HB_IN=/path/to/test_video.mp4

# ============================================================================
# Backend API (Post-MVP)
# ============================================================================
SO_BACKEND_API_URL=http://localhost:7091

# ============================================================================
# Admin Credentials (for future backend integration)
# ============================================================================
SA_EMAIL=admin@example.com
SA_PASSWORD=password

# ============================================================================
# Optional: Google Cloud Storage (if using GCS for image storage)
# ============================================================================
# GCS_CREDENTIALS_PATH=/app/keys/gcs-service-account.json
# GCS_BUCKET=hbai-general-data

# ============================================================================
# Optional: Model Configuration Overrides
# ============================================================================
# PERSON_MODEL_SIZE=s       # YOLOv8-Pose model size: n/s/m/l/x
# PHONE_MODEL_SIZE=n        # YOLOv8 phone detection: n/s/m/l/x
# TARGET_FPS=12             # Target FPS for processing

# ============================================================================
# Optional: Logging
# ============================================================================
# LOG_LEVEL=INFO            # DEBUG/INFO/WARNING/ERROR
